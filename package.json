{
  "name": "mourn-bot",
  "version": "1.0.0",
  "description": "Mourn — a feature-rich Discord bot for community and utility server management.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc || true",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "register": "tsx src/scripts/register.ts",
    "register:guild": "tsx src/scripts/register.ts",
    "db:push": "drizzle-kit push"
  }
}