{
  "name": "mourn-bot",
  "version": "1.0.0",
  "description": "Mourn — a feature-rich Discord bot for community and utility server management.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc || true",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "register": "tsx src/scripts/register.ts",
    "register:guild": "tsx src/scripts/register.ts",
    "db:push": "drizzle-kit push"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.0",
    "discord.js": "^14.16.3",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1",
    "dotenv": "^16.4.7",
    "ms": "^2.1.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "distube": "^5.2.3",
    "@distube/youtube": "^1.0.4",
    "@discordjs/voice": "^0.17.0",
    "@discordjs/opus": "^0.9.0",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/ms": "^0.7.34",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
