# ─────────────────────────────────────────────
  # Mourn Bot — Environment Variables
  # Copy this to .env and fill in your values
  # ─────────────────────────────────────────────

  # Discord bot token — from https://discord.com/developers/applications
  DISCORD_TOKEN=your_bot_token_here

  # Your Discord user ID (Developer Mode → right-click your name → Copy User ID)
  BOT_OWNER_ID=your_discord_user_id_here

  # Default command prefix for new servers (default: ,)
  DEFAULT_PREFIX=,

  # PostgreSQL connection string
  # Railway: set automatically when you add a Postgres plugin
  # Local: postgres://user:password@localhost:5432/mourncord
  DATABASE_URL=postgres://user:password@host:5432/dbname

  # Optional: log level (debug | info | warn | error)
  LOG_LEVEL=info

  # Optional: bot invite link (shown in ,about command)
  BOT_INVITE_URL=

  # Optional: set this to register slash commands to ONE guild instantly (for dev)
  # Leave blank to register globally (takes up to 1 hour to propagate)
  # GUILD_ID=your_server_id_here
  