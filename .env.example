# Villain — environment configuration
# Copy to .env locally, or add these values in your hosting provider.

# Required: Discord bot token
DISCORD_TOKEN=your_bot_token_here

# Required: Discord user ID of the bot owner
BOT_OWNER_ID=your_discord_user_id_here

# Optional: default prefix for new servers
DEFAULT_PREFIX=,

# Optional: PostgreSQL connection string (database features are disabled without it)
DATABASE_URL=

# Optional: set false to disable database access even when DATABASE_URL exists
ENABLE_DATABASE=true

# Optional logging
LOG_LEVEL=info

# Optional: invite link shown by bot information commands
BOT_INVITE_URL=

# Optional: register slash commands to one server while testing
# GUILD_ID=your_server_id_here

# Optional integrations
LASTFM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
FORTNITE_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
KICK_API_KEY=
X_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN=
