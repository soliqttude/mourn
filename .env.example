# Villain — environment configuration
# Copy to .env locally, or add these values in your hosting provider.

DISCORD_TOKEN=your_bot_token_here
BOT_OWNER_ID=your_discord_user_id_here
DEFAULT_PREFIX=,
DATABASE_URL=
ENABLE_DATABASE=true
LOG_LEVEL=info
BOT_INVITE_URL=

# Optional: register slash commands to one test server
# GUILD_ID=your_server_id_here

# Optional integrations
LASTFM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
FORTNITE_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
KICK_API_KEY=
X_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN=
